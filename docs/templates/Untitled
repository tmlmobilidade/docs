/**
 * sort-headings-on-save.js
 *
 * Templater startup script that sorts all markdown headings (H1–H6)
 * alphabetically whenever a file with `sort_headings: true` in its
 * frontmatter is saved.
 *
 * Setup:
 *   1. Install the "Templater" community plugin
 *   2. In Templater settings → "Startup Templates", add this file
 *   3. Add `sort_headings: true` to the frontmatter of any file you want sorted
 *
 * The script registers once on startup and persists for the session.
 * Reload Obsidian (or run the template manually) to re-register after changes.
 */

async function sortHeadingsOnSave(app) {
  // ── Block parser ────────────────────────────────────────────────────────────

  /** @returns {number} 1–6 for headings, 0 for normal lines */
  function headingLevel(line) {
    const m = line.match(/^(#{1,6}) /);
    return m ? m[1].length : 0;
  }

  function headingText(line) {
    return line.replace(/^#+\s+/, "").trim();
  }

  /**
   * Recursively parse flat lines into a block tree.
   * Each block owns its heading, body lines, and child blocks.
   *
   * @param {string[]} lines
   * @param {number} parentLevel - only consume headings strictly deeper than this
   * @returns {{ blocks: Block[], remaining: string[] }}
   */
  function parseBlocks(lines, parentLevel = 0) {
    const blocks = [];
    let i = 0;

    while (i < lines.length) {
      const level = headingLevel(lines[i]);

      // Return to caller when we hit a heading at/above our parent level
      if (level === 0 || level <= parentLevel) break;

      const block = { heading: lines[i], level, body: [], children: [] };
      i++;

      // Consume non-heading body lines belonging directly to this heading
      while (i < lines.length && headingLevel(lines[i]) === 0) {
        block.body.push(lines[i]);
        i++;
      }

      // Recurse: collect child headings (strictly deeper level)
      const { blocks: children, remaining } = parseBlocks(lines.slice(i), level);
      block.children = children;
      i += lines.length - i - remaining.length;

      blocks.push(block);
    }

    return { blocks, remaining: lines.slice(i) };
  }

  /**
   * Recursively sort blocks by heading text.
   * Uses numeric + case-insensitive locale compare so "A2" < "A10".
   */
  function sortBlocks(blocks) {
    return blocks
      .map((b) => ({ ...b, children: sortBlocks(b.children) }))
      .sort((a, b) =>
        headingText(a.heading).localeCompare(headingText(b.heading), undefined, {
          sensitivity: "base",
          numeric: true,
        })
      );
  }

  /** Flatten block tree back to lines */
  function renderBlocks(blocks) {
    return blocks.flatMap((b) => [
      b.heading,
      ...b.body,
      ...renderBlocks(b.children),
    ]);
  }

  /**
   * Sort all headings in a markdown string.
   * Preserves frontmatter and any content before the first heading.
   *
   * @param {string} content
   * @returns {{ sorted: string, changed: boolean }}
   */
  function sortMarkdownHeadings(content) {
    const lines = content.split("\n");

    // Detect and preserve YAML frontmatter (--- ... ---)
    let frontmatterEnd = 0;
    if (lines[0]?.trim() === "---") {
      for (let i = 1; i < lines.length; i++) {
        if (lines[i]?.trim() === "---") {
          frontmatterEnd = i + 1;
          break;
        }
      }
    }

    const bodyLines = lines.slice(frontmatterEnd);

    // Preamble: non-heading lines before the first heading
    let preambleEnd = 0;
    for (let i = 0; i < bodyLines.length; i++) {
      if (headingLevel(bodyLines[i]) > 0) {
        preambleEnd = i;
        break;
      }
      preambleEnd = i + 1;
    }

    const preamble = bodyLines.slice(0, preambleEnd);
    const { blocks, remaining } = parseBlocks(bodyLines.slice(preambleEnd));
    const sortedLines = renderBlocks(sortBlocks(blocks));

    const sorted = [
      ...lines.slice(0, frontmatterEnd),
      ...preamble,
      ...sortedLines,
      ...remaining,
    ].join("\n");

    return { sorted, changed: sorted !== content };
  }

  // ── Obsidian event handler ──────────────────────────────────────────────────

  // Track in-flight rewrites to avoid re-triggering on our own vault.modify()
  const rewriting = new Set();

  // Debounce timers per file path (editors can fire multiple modify events per save)
  const debounceMap = new Map();

  async function handleModify(file) {
    if (!(file instanceof app.vault.adapter.constructor) && file.extension !== "md") return;
    if (rewriting.has(file.path)) return;

    // Debounce: wait for burst of modify events to settle (150ms)
    if (debounceMap.has(file.path)) clearTimeout(debounceMap.get(file.path));
    debounceMap.set(
      file.path,
      setTimeout(async () => {
        debounceMap.delete(file.path);
        await processFile(file);
      }, 150)
    );
  }

  async function processFile(file) {
    // Re-fetch the file handle in case it's a TFile
    const tfile = app.vault.getAbstractFileByPath(file.path);
    if (!tfile || tfile.extension !== "md") return;

    // Check frontmatter flag without parsing the whole file
    const frontmatter = app.metadataCache.getFileCache(tfile)?.frontmatter;
    if (!frontmatter?.sort_headings) return;

    const content = await app.vault.read(tfile);
    const { sorted, changed } = sortMarkdownHeadings(content);

    if (!changed) return;

    // Guard against re-entry: our own write will trigger another modify event
    rewriting.add(tfile.path);
    try {
      await app.vault.modify(tfile, sorted);
    } finally {
      // Clear guard after a tick so the echoed modify event is already queued
      setTimeout(() => rewriting.delete(tfile.path), 200);
    }
  }

  // ── Register with Obsidian ──────────────────────────────────────────────────

  // Unregister any previous instance (e.g. template re-run without reload)
  const HANDLER_KEY = "__sortHeadingsHandler__";
  if (app[HANDLER_KEY]) {
    app.vault.offref(app[HANDLER_KEY]);
  }

  app[HANDLER_KEY] = app.vault.on("modify", handleModify);

  console.log("[sort-headings] Registered on-save heading sorter.");
}

// Templater exposes `app` as a global; call the setup function.
await sortHeadingsOnSave(app);