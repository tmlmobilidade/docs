{
	"name": "@tmlmobilidade/docs",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"dev": "next dev -p 50000",
		"edit": "npx --yes @fumadocs-editor/studio --root ./docs",
