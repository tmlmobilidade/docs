		"@tmlmobilidade/utils": "latest",
		"@turf/turf": "7.4.0",
		"@vis.gl/react-maplibre": "8.1.3",
		"class-variance-authority": "0.7.1",
		"fumadocs-core": "16.15.13",
		"fumadocs-mdx": "15.4.3",
		"fumadocs-obsidian": "1.0.5",
		"fumadocs-ui": "16.15.13",
		"katex": "0.18.7",
		"lucide-react": "1.47.0",
